class DSU {
private:
    vector<int> parents;
    vector<int> size;

public:
    DSU(int n) {
        parents.resize(n);
        for (int i = 0; i < n; i++)
            parents[i] = i;
        size.resize(n, 1);
    }

    int find(int i) {
        if (parents[i] == i) return i;
        return parents[i] = find(parents[i]);
    }

    bool isConnected(int i, int j) {
        return find(i) == find(j);
    }

    void connect(int i, int j) {
        if (isConnected(i, j)) return;

        int p1 = find(i);
        int p2 = find(j);

        if (size[p1] < size[p2]) swap(p1, p2);
        size[p1] += size[p2];
        parents[p2] = p1;
    }
};


