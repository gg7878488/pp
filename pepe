bool traject(const vector<vector<int>> &matrix, int m) {
    if (matrix[0][0] == 0 || matrix[m-1][m-1] == 0)
        return false;

    DSU dsu(m * m);

    for (int i = 0; i < m; i++) {
        for (int j = 0; j < m; j++) {
            if (matrix[i][j] == 0) continue;

            int v = i * m + j;

            if (j > 0 && matrix[i][j - 1] == 1) {
                dsu.connect(v, i * m + (j - 1));
            }

            if (i > 0 && matrix[i - 1][j] == 1) {
                dsu.connect(v, (i - 1) * m + j);
            }
        }
    }

    return dsu.isConnected(0, m * m - 1);
}

